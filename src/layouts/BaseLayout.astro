---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  socialImage?: string | false;
  theme?: "light" | "deep";
}

const {
  title = "心猿意马的羊｜交易复盘",
  description = "持续记录市场事实、当前判断、判断边界与后续校准。",
  noindex = false,
  socialImage = "/og.png",
  theme = "light",
} = Astro.props;

const pageTitle = title === "心猿意马的羊｜交易复盘" ? title : `${title}｜心猿意马的羊`;
const resolvedSocialImage = socialImage === false ? null : new URL(socialImage, Astro.url).toString();
const currentPath = Astro.url.pathname;
const navItems = [
  { href: "/", label: "首页" },
  { href: "/daily/", label: "每日复盘" },
  { href: "/weekly/", label: "每周复盘" },
  { href: "/archive/", label: "归档" },
  { href: "/about/", label: "关于" },
];

const isCurrent = (href: string) => href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<!doctype html>
<html lang="zh-CN" class={theme === "deep" ? "theme-deep" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {resolvedSocialImage && <meta property="og:image" content={resolvedSocialImage} />}
    <meta name="twitter:card" content={resolvedSocialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {resolvedSocialImage && <meta name="twitter:image" content={resolvedSocialImage} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="心猿意马的羊交易复盘首页">
          <span class="brand-mark">羊</span>
          <span>
            <strong>心猿意马的羊</strong>
            <small>交易复盘</small>
          </span>
        </a>
        <nav aria-label="主要导航">
          {navItems.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <strong>心猿意马的羊｜交易复盘</strong>
          <p>记录市场，校准判断，与交易爱好者平视交流。</p>
        </div>
        <div class="footer-links">
          <a href="/research/">研究笔记</a>
          <a href="/about/#tools">研究工具</a>
          <a href="/#disclaimer">免责声明</a>
        </div>
      </div>
    </footer>
  </body>
</html>
